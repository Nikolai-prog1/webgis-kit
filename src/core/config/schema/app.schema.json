  "required": ["version", "app", "map"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/webgis/app.schema.json",
  "title": "WebGIS application configuration",
  "$defs": {
    "layer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "geometry": {
          "enum": ["point", "line", "polygon", "raster"]
        },
        "source": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["wms", "geojson", "wfs", "xyz"]
            },
            "service": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "layers": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            },
            "dataProjection": {
              "type": "string"
            },
            "strategy": {
              "enum": ["bbox", "all"]
            },
            "attribution": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "style": {
              "type": ["string", "null"]
            },
            "labelStyle": {
              "type": ["string", "null"]
            },
            "tiled": {
              "type": "boolean"
            },
            "params": {
              "type": "object"
            },
            "projection": {
              "type": ["string", "null"]
            },
            "hidpi": {
              "type": "boolean"
            },
            "emptyOnException": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scaleCompensation": {
              "type": "boolean"
            },
            "maxFeatures": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["type"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "wms"
                  }
                }
              },
              "then": {
                "required": ["service", "layers"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "geojson"
                  }
                }
              },
              "then": {
                "required": ["url"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "wfs"
                  }
                }
              },
              "then": {
                "required": ["service", "typeName"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "xyz"
                  }
                }
              },
              "then": {
                "required": ["url"]
              }
            }
          ]
        },
        "query": {
          "type": "object",
          "properties": {
            "service": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "required": ["service", "typeName"],
          "additionalProperties": false
        },
        "visible": {
          "type": "boolean"
        },
        "queryable": {
          "type": "boolean"
        },
        "table": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zIndex": {
          "type": ["number", "null"]
        },
        "minScale": {
          "type": ["number", "null"]
        },
        "maxScale": {
          "type": ["number", "null"]
        },
        "extent": {
          "type": ["array", "null"],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "style": {
          "type": "object",
          "properties": {
            "fill": {
              "type": "string"
            },
            "fillOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "stroke": {
              "type": "string"
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0
            },
            "dasharray": {
              "type": ["array", "null"],
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "shape": {
              "enum": ["circle", "square", "triangle", "diamond"]
            },
            "label": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "size": {
                  "type": "number",
                  "minimum": 0
                },
                "color": {
                  "type": "string"
                },
                "halo": {
                  "type": "string"
                },
                "minZoom": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["field"],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "legend": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": ["point", "line", "polygon", "raster", "image"]
                  },
                  "label": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
