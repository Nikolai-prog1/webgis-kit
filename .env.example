# Optional proxy targets. Public demo needs none.
# GEOSERVER_URL=http://localhost:8080
# EXT_WMS_URL=https://ows.terrestris.de/osm/service

# Existing servers: fill these locally. Never commit credentials.
# GeoServer import expects the full base URL, including /geoserver.
# WEBGIS_DB_HOST=localhost
# WEBGIS_DB_PORT=5432
# WEBGIS_DB_NAME=webgis
# WEBGIS_DB_USER=webgis
# WEBGIS_DB_PASSWORD=
# GEOSERVER_URL=http://localhost:8080/geoserver
# GEOSERVER_USER=admin
# GEOSERVER_PASSWORD=
# WEBGIS_PSQL=
# WEBGIS_OGR2OGR=
