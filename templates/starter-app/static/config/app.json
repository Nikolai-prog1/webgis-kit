{
  "version": 1,
  "app": {
    "id": "webgis",
    "title": "My web map",
    "locale": "en",
    "locales": ["en", "bg"]
  },
  "branding": {
    "title": "My web map"
  },
  "map": {
    "center": [25, 43],
    "zoom": 6
  },
  "crs": [
    {
      "code": "EPSG:4326",
      "label": "WGS84",
      "kind": "geographic",
      "decimals": 5
    },
    {
      "code": "EPSG:3857",
      "label": "Web Mercator",
      "kind": "projected",
      "decimals": 0,
      "bbox": [-20037508, -20037508, 20037508, 20037508]
    }
  ],
  "basemaps": {
    "default": "osm",
    "allowNone": true,
    "items": [
      {
        "id": "osm",
        "type": "osm",
        "title": "OpenStreetMap"
      }
    ]
  },
  "layers": [],
  "sidebar": [
    {
      "id": "basemaps",
      "title": {
        "bg": "Базови карти",
        "en": "Base maps"
      },
      "open": true,
      "blocks": [
        {
          "type": "basemap-switcher"
        }
      ]
    }
  ],
  "toolbar": [
    "measure-distance",
    "measure-area",
    "marker",
    "goto-coordinates",
    "home",
    "print",
    "clear"
  ],
  "statusBar": {
    "coordinates": ["EPSG:4326", "EPSG:3857"],
    "scaleLine": true
  }
}
