{
  "name": "webgis-kit",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "import": "node tools/import/run.mjs",
    "stack": "node tools/stack/index.mjs",
    "smoke": "node tools/smoke.mjs",
    "release-version": "node tools/release-version.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --project jsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "validate": "node tools/validate-config.mjs && node tools/generate-config-reference.mjs --check",
    "leak-check": "node tools/leak-check.mjs",
    "screenshots": "playwright test --project=screenshots",
    "update-core": "node tools/update-core.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:python && npm run validate && npm run build && npm run test:e2e && npm run leak-check",
    "test:python": "python -m unittest discover -s tests/python -v",
    "reference": "node tools/generate-config-reference.mjs",
    "notices": "node tools/collect-notices.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@tabler/icons-webfont": "3.52.0",
    "ol": "10.11.0",
    "proj4": "2.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/punycode": "2.1.4",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
