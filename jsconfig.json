{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "@app/*": ["./app/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.js", "app/plugins/**/*.js", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
